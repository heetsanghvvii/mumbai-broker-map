# Google Maps Platform browser key (restrict it by HTTP referrer — see README)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud Console > Map Management (vector, JavaScript).
# Leave empty to use Google's DEMO_MAP_ID while developing.
VITE_GOOGLE_MAP_ID=

# Google Form where brokers claim their profile
VITE_CLAIM_FORM_URL=https://forms.gle/REPLACE_WITH_YOUR_FORM
