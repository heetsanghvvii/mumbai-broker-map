# ---- Browser (bundled into the site; must be safe to be public) ----
# Google Maps JavaScript + Places key, restricted by website. See README.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (vector, JavaScript). Empty uses Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
# Supabase project with the broker directory (supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (Vercel functions; never prefix with VITE_) ----
# Routes API key for Commute Search. "simulate" fakes travel times in `npm run dev`.
GOOGLE_ROUTES_KEY=
# Random secrets: openssl rand -hex 32
COMMUTE_DB_SECRET=
UNLOCK_SECRET=
# Payments: UPI (manual approval on /admin.html) until Razorpay keys are set
UPI_ID=
UPI_NAME=
ADMIN_PASSWORD=
# Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional
COMMUTE_CACHE_HOURS=168
COMMUTE_PRICE_PAISE=14900
